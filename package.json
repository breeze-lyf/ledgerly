{
  "name": "ledgerly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build:web && tsx watch server/index.ts",
    "build:web": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "build": "npm run build:web && tsc -p tsconfig.server.json",
    "start": "node dist/index.js",
    "seed:sandbox": "node scripts/seed-sandbox.mjs",
    "seed": "tsx scripts/seed.ts",
    "reset": "tsx scripts/reset.ts",
    "smoke": "bash scripts/smoke.sh",
    "ui-check": "node scripts/ui-check.mjs",
    "sandbox:e2e": "node scripts/sandbox-e2e.mjs",
    "webhook:register": "node scripts/register-webhook.mjs",
    "webhook:simulate": "node scripts/simulate-webhook.mjs",
    "test:orders": "PAYPAL_ENV_FILE=/nonexistent PAYPAL_MODE=mock DB_PATH=:memory: tsx scripts/order-tests.ts"
  },
  "dependencies": {
    "@paypal/agent-toolkit": "1.11.0",
    "axios": "^1.21.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "1.63.0-alpha-2026-08-31",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
